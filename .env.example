# Salin file ini menjadi .env lalu sesuaikan. JANGAN commit file .env.
APP_ENV=lokal

# Database prototype (lokal)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAMA=vendor_management_prototype
DB_USER=root
DB_PASS=

# Sumber akun staf: lokal | siap_lintas
# lokal       = tbl_user tiruan di database prototype (data fiktif)
# siap_lintas = baca tbl_user dari salinan database `siap` lokal (read-only), dikerjakan di tahap berikutnya
SUMBER_USER=lokal

# Hanya dipakai bila SUMBER_USER=siap_lintas. Gunakan user MySQL read-only.
DB_SIAP_HOST=127.0.0.1
DB_SIAP_PORT=3306
DB_SIAP_NAMA=siap
DB_SIAP_USER=
DB_SIAP_PASS=

# Sumber login staf: lokal | sesi_siap
# lokal      = halaman masuk-staf milik prototype (pengujian/presentasi)
# sesi_siap  = staf sudah login di SIAP; modul membaca $_SESSION['user_id'].
#              Nama kunci session SIAP BELUM dikonfirmasi (asumsi mengikuti project CRF).
SUMBER_LOGIN=lokal
# Nama cookie session. Pada mode sesi_siap harus sama dengan nama session SIAP (belum diketahui).
SESSION_NAME=vmp_sesi

# 1 = tampilkan rincian galat di layar (HANYA untuk pengembangan lokal). Bawaan 0.
APP_DEBUG=0
